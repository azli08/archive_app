APP_NAME=Collectly API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://collectly:collectly@localhost:5433/collectly
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
POSTGRES_HOST_PORT=5433

# Local Docker Compose database only. Change these values outside local development.
POSTGRES_DB=collectly
POSTGRES_USER=collectly
POSTGRES_PASSWORD=collectly
